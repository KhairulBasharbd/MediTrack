datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(PATIENT)
  specialization String?       // e.g. "Cardiology", "General Medicine" for doctors
  phone          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")

  @@map("users")
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  doctorId    String
  scheduledAt DateTime
  symptoms    String
  aiCategory  String?           // e.g. "Respiratory", "Cardiac", "General"
  aiUrgency   UrgencyLevel?     // LOW, MEDIUM, HIGH, EMERGENCY
  aiAdvice    String?           // AI triage explanation & medical disclaimer
  status      AppointmentStatus @default(PENDING)
  notes       String?           // Doctor's private consultation notes
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@map("appointments")
}
